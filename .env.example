# =============================================================================
# AIOps Agent Platform - 环境变量模板（Docker 部署用）
# =============================================================================
# 【用途】本文件是 Docker Compose 部署的模板，列出 Compose 与当前应用配置
#   链路实际消费的变量；其余运行参数（APP_ENV、Agent/记忆/WS 配置等）已在
#   compose 文件的 environment 块中写死，不从本文件读取。
#   → Docker 部署：在仓库根 `cp .env.example .env`，按需填写。
#   → 本地开发（cd backend && uvicorn）：改用 `backend/.env.example`。
#
# 【重要】纯规则模式不需要任何 LLM Key：所有变量留默认值即可完整运行，
#   系统会自动走规则路径（异常检测/根因分析/NLU/评测均有规则实现）。
#
# 【重要】当前 Compose 不透传 LLM_ENABLE_RCA / LLM_ENABLE_NLU /
#   LLM_ENABLE_JUDGE 功能开关（代码默认全关）。只填 LLM_API_KEY 不会
#   自动启用全部 LLM 功能。
#
# 【说明】docker-compose.yml 中的 chroma 容器为编排预留服务：后端主代码
#   当前使用 ChromaDB 本地 PersistentClient 持久化，未连接该独立容器。
#
# 注意：.env 不应提交到版本控制（已在 .gitignore 中）。
# =============================================================================

# =============================================================================
# LLM 配置（可选 — 不填则为纯规则模式）
# =============================================================================

# 主 LLM API Key（OpenAI 兼容格式；留空 = 禁用 LLM）
LLM_API_KEY=your-provider-api-key

# LLM 提供商：openai | deepseek | azure-openai
LLM_PROVIDER=openai

# LLM 模型名称（如 gpt-4o-mini / deepseek-chat）
LLM_MODEL=gpt-4o-mini

# 当前主 LLMService 只读取通用 LLM_API_KEY。Compose 文件仍保留
# OPENAI_API_KEY / DEEPSEEK_API_KEY 兼容透传项，但当前主配置链不消费它们，
# 因此本模板不将其列为有效配置入口。

# =============================================================================
# Langfuse 可观测性（可选，默认关闭）
# =============================================================================

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
