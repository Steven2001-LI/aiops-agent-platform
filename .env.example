# =============================================================================
# AIOps Agent Platform - 环境变量配置示例
# =============================================================================
# 【用途】本文件是 **Docker 部署** 的模板。docker-compose 会读取仓库根目录的
#   .env 来做 ${VAR} 变量替换（见 docker-compose*.yml 的 environment 块），
#   deploy.sh 也在根目录 cp .env.example .env。
#   → Docker 部署：在仓库根 `cp .env.example .env` 并填 key。
#   → 本地开发（cd backend && uvicorn）：改用 `backend/.env.example`，
#     配置从 backend/.env 读（pydantic env_file 相对 CWD）。两条路径互不影响。
#
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 注意：.env 文件不应提交到版本控制（已加入 .gitignore）
# =============================================================================

# =============================================================================
# LLM 模型配置（必填）
# =============================================================================

# 主 LLM API Key（OpenAI 兼容格式）
# 支持：OpenAI、DeepSeek、兼容OpenAI API的第三方服务
LLM_API_KEY=your-llm-api-key-here

# LLM 提供商：openai | deepseek | azure-openai | custom
LLM_PROVIDER=openai

# LLM 模型名称
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# DeepSeek: deepseek-chat, deepseek-reasoner
LLM_MODEL=gpt-4o-mini

# =============================================================================
# 特定提供商 API Key（可选，用于多模型场景）
# =============================================================================

# OpenAI 专用 API Key（如与主Key不同）
OPENAI_API_KEY=your-openai-api-key

# DeepSeek 专用 API Key
DEEPSEEK_API_KEY=your-deepseek-api-key

# =============================================================================
# Langfuse 可观测性配置（可选）
# =============================================================================

# Langfuse 公钥
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key

# Langfuse 私钥
LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# Langfuse 服务地址
LANGFUSE_HOST=https://cloud.langfuse.com

# 是否启用 Langfuse
LANGFUSE_ENABLED=false

# =============================================================================
# 应用基础配置
# =============================================================================

# 运行环境：development | testing | staging | production
APP_ENV=production

# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO

# =============================================================================
# 高级配置（通常使用默认值即可）
# =============================================================================

# --- Agent 配置 ---
# AGENT_EXECUTION_TIMEOUT_SECONDS=120
# AGENT_MAX_ITERATIONS=10
# AGENT_PARALLEL_WORKERS=3
# AGENT_HEAL_DRY_RUN=true
# AGENT_RCA_MIN_CONFIDENCE=0.7

# --- 数据库配置 ---
# DATABASE_URL=sqlite:///./data/aiops.db
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# --- 记忆系统配置 ---
# MEMORY_SHORT_TERM_MAX_ITEMS=100
# MEMORY_LONG_TERM_MAX_ITEMS=10000
# MEMORY_SIMILARITY_THRESHOLD=0.85
# MEMORY_RETENTION_DAYS=90

# --- WebSocket 配置 ---
# WS_HEARTBEAT_INTERVAL_SECONDS=30
# WS_MAX_CONNECTIONS=100
