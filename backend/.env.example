# =============================================================================
# AIOps Agent Platform - Environment Variables
# =============================================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=true

# --- LLM Configuration(建议 DeepSeek,便宜且国内直连)---
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# 自定义 base_url(优先于 provider 预设,一般留空)
# LLM_BASE_URL=
# 功能开关(代码默认全关,此处为推荐开启示例)
LLM_ENABLE_RCA=true
LLM_ENABLE_NLU=true
LLM_ENABLE_JUDGE=false
# 可选:NLU/Judge 单独用便宜模型(空 = 用主模型)
# LLM_NLU_MODEL=deepseek-chat
# LLM_JUDGE_MODEL=deepseek-chat
# NLU 快慢路径置信度阈值
# LLM_NLU_FAST_PATH_CONFIDENCE=0.6

# --- Langfuse Observability ---
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database ---
DATABASE_URL=sqlite:///./data/aiops.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- ChromaDB ---
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=aiops_memory

# --- Agent Configuration ---
AGENT_EXECUTION_TIMEOUT_SECONDS=120
AGENT_MAX_ITERATIONS=10
AGENT_PARALLEL_WORKERS=3
AGENT_HEAL_DRY_RUN=true
AGENT_RCA_MIN_CONFIDENCE=0.7

# --- Memory System ---
MEMORY_SHORT_TERM_MAX_ITEMS=100
MEMORY_LONG_TERM_MAX_ITEMS=10000
MEMORY_SIMILARITY_THRESHOLD=0.85
MEMORY_RETENTION_DAYS=90

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=100

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_KEY_HEADER=X-API-Key
