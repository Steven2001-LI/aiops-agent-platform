# =============================================================================
# AIOps Agent Platform - 环境变量模板（本地后端开发用）
# =============================================================================
# 【用途】本文件是本地后端开发的模板。从 backend/ 目录运行
#   （cd backend && uvicorn app.main:app）时，pydantic-settings 的
#   env_file=".env" 相对 CWD，配置从 backend/.env 读取。
#   → 本地开发：`cp backend/.env.example backend/.env`，按需填写。
#   → Docker 部署：改用仓库根的 `.env.example`。
#
# 【重要】LLM 是可选能力：LLM_API_KEY 留空即为纯规则模式，异常检测、
#   根因分析、NLU、评测全部走规则路径，功能完整可用。
# =============================================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=true

# CORS 允许来源。注意：必须使用 JSON 数组格式（测试同样要求此格式），
# 逗号分隔字符串会导致 pydantic-settings 解析 list 字段失败。
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- LLM 配置（可选 — 留空 Key 即纯规则模式）---
LLM_PROVIDER=deepseek
LLM_API_KEY=your-provider-api-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# 自定义 base_url（优先于 provider 预设，一般留空）
# LLM_BASE_URL=

# --- LLM 功能开关（代码默认全关，三个开关相互独立）---
# RCA 多路证据 LLM 融合推理；关闭或 LLM 不可用时降级规则综合
LLM_ENABLE_RCA=false
# 自然语言理解 LLM 慢路径；关闭或不可用时走正则快路径
LLM_ENABLE_NLU=false
# 评测 LLM-as-Judge 推理链评分；关闭或不可用时用纯规则指标
LLM_ENABLE_JUDGE=false
# 可选：NLU/Judge 单独指定更便宜的模型（留空 = 用主模型）
# LLM_NLU_MODEL=
# LLM_JUDGE_MODEL=
# NLU 快慢路径置信度阈值
# LLM_NLU_FAST_PATH_CONFIDENCE=0.6

# --- Langfuse 可观测性（可选）---
# 启用条件：LANGFUSE_ENABLED=true 且 PUBLIC_KEY 非空（两者都要）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database ---
DATABASE_URL=sqlite:///./data/aiops.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- ChromaDB ---
# 当前主代码使用本地 PersistentClient 持久化到以下目录，
# 不连接独立 ChromaDB 服务。
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=aiops_memory

# --- Agent Configuration ---
AGENT_EXECUTION_TIMEOUT_SECONDS=120
AGENT_MAX_ITERATIONS=10
AGENT_PARALLEL_WORKERS=3
AGENT_HEAL_DRY_RUN=true
AGENT_RCA_MIN_CONFIDENCE=0.7

# --- Memory System ---
MEMORY_SHORT_TERM_MAX_ITEMS=100
MEMORY_LONG_TERM_MAX_ITEMS=10000
MEMORY_SIMILARITY_THRESHOLD=0.85
MEMORY_RETENTION_DAYS=90

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=100
