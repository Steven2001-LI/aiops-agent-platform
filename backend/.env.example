# =============================================================================
# AIOps Agent Platform - Environment Variables
# =============================================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=true

# --- LLM Configuration ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Langfuse Observability ---
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database ---
DATABASE_URL=sqlite:///./data/aiops.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- ChromaDB ---
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=aiops_memory

# --- Agent Configuration ---
AGENT_EXECUTION_TIMEOUT_SECONDS=120
AGENT_MAX_ITERATIONS=10
AGENT_PARALLEL_WORKERS=3
AGENT_HEAL_DRY_RUN=true
AGENT_RCA_MIN_CONFIDENCE=0.7

# --- Memory System ---
MEMORY_SHORT_TERM_MAX_ITEMS=100
MEMORY_LONG_TERM_MAX_ITEMS=10000
MEMORY_SIMILARITY_THRESHOLD=0.85
MEMORY_RETENTION_DAYS=90

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=100

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_KEY_HEADER=X-API-Key
